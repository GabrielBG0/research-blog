---
const pathname = Astro.url.pathname;
const isHome = pathname === "/" || pathname === "";
const isBlog = pathname.startsWith("/blog");
const isAbout = pathname.startsWith("/about");

const navItems = [
  { href: "/", label: "Index", active: isHome },
  { href: "/blog", label: "Notes", active: isBlog },
  { href: "/about", label: "About", active: isAbout },
];
---

<header class="nb-site-header">
  <div class="nb-container nb-header">
    <a href="/" class="nb-brand" aria-label="Home">
      <span class="nb-mark" aria-hidden="true">
        <svg viewBox="0 0 74 86" width="22" height="26" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M36.0384 1.36948C36.3145 0.402057 37.6855 0.402061 37.9616 1.36949L45.3286 27.1834C45.4767 27.7024 46.0098 28.0102 46.5333 27.879L72.5723 21.352C73.5481 21.1074 74.2337 22.2947 73.5339 23.0175L54.8619 42.3044C54.4865 42.6922 54.4865 43.3078 54.8619 43.6956L73.5339 62.9825C74.2337 63.7053 73.5481 64.8926 72.5723 64.648L46.5333 58.121C46.0098 57.9898 45.4767 58.2976 45.3286 58.8166L37.9616 84.6305C37.6855 85.5979 36.3145 85.5979 36.0384 84.6305L28.6714 58.8166C28.5233 58.2976 27.9902 57.9898 27.4667 58.121L1.42772 64.648C0.451859 64.8926 -0.233654 63.7053 0.466117 62.9825L19.1381 43.6956C19.5135 43.3078 19.5135 42.6922 19.1381 42.3044L0.466114 23.0175C-0.233657 22.2947 0.451862 21.1074 1.42772 21.352L27.4667 27.879C27.9902 28.0102 28.5233 27.7024 28.6714 27.1834L36.0384 1.36948Z"/>
        </svg>
      </span>
      <span>
        <div class="nb-brand-name">Gabriel B. Gutierrez</div>
        <div class="nb-brand-sub">Research notebook · est. 2026</div>
      </span>
    </a>

    <nav class="nb-nav" aria-label="Main navigation">
      {navItems.map(item => (
        <a
          href={item.href}
          class="nb-nav-link"
          aria-current={item.active ? "page" : undefined}
        >{item.label}</a>
      ))}

      <span class="nb-nav-sep" aria-hidden="true"></span>

      <a class="nb-nav-icon" href="mailto:gabriel.gutierrez@ic.unicamp.br" title="Email">
        <span class="sr-only">Send email</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2"/>
          <path d="m3 7 9 6 9-6"/>
        </svg>
      </a>

      <a class="nb-nav-icon" href="https://scholar.google.com/citations?user=g6yM01cAAAAJ" target="_blank" rel="noopener noreferrer" title="Google Scholar">
        <span class="sr-only">Google Scholar profile</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M2 9 12 4l10 5-10 5L2 9Z"/>
          <path d="M7 11v5a5 5 0 0 0 10 0v-5"/>
        </svg>
      </a>

      <a class="nb-nav-icon" href="https://github.com/GabrielBG0" target="_blank" rel="noopener noreferrer" title="GitHub">
        <span class="sr-only">GitHub profile</span>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.87-1.36-3.87-1.36-.52-1.32-1.28-1.67-1.28-1.67-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.07.78 2.16v3.21c0 .31.21.68.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5Z"/>
        </svg>
      </a>

      <button class="nb-theme" id="theme-toggle" aria-label="Toggle theme">
        <span class="icon-to-dark">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" width="12" height="12" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/>
          </svg>
          <span>Dark</span>
        </span>
        <span class="icon-to-light">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" width="12" height="12" aria-hidden="true">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
          </svg>
          <span>Light</span>
        </span>
      </button>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("theme-toggle");

  function updateToggleDisplay() {
    const isDark = document.documentElement.getAttribute("data-theme") === "dark";
    document.documentElement.setAttribute("data-nb-dark", isDark ? "true" : "false");
  }

  toggle?.addEventListener("click", () => {
    const current = document.documentElement.getAttribute("data-theme");
    const next = current === "dark" ? "light" : "dark";
    document.documentElement.setAttribute("data-theme", next);
    localStorage.setItem("theme", next);
    updateToggleDisplay();
  });

  updateToggleDisplay();
</script>

<style>
  .nb-site-header {
    background: transparent;
  }

  .nb-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding-top: 36px;
    padding-bottom: 20px;
  }

  .nb-brand {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    color: var(--ink);
  }
  .nb-brand:hover { opacity: 0.75; }

  .nb-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    color: var(--accent);
    flex-shrink: 0;
  }
  .nb-mark svg { display: block; }

  .nb-brand-name {
    font-size: 19px;
    font-weight: 500;
    letter-spacing: 0.005em;
    color: var(--ink);
  }
  .nb-brand-sub {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 3px;
    white-space: nowrap;
  }

  .nb-nav {
    display: flex;
    gap: 22px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    align-items: center;
  }

  .nb-nav-link {
    color: var(--muted);
    text-decoration: none;
    padding-bottom: 4px;
    border-bottom: 1px solid transparent;
  }
  .nb-nav-link:hover { color: var(--ink); opacity: 1; }
  .nb-nav-link[aria-current="page"] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  .nb-nav-sep {
    width: 1px;
    height: 12px;
    background: var(--rule);
    display: inline-block;
    flex-shrink: 0;
  }

  .nb-nav-icon {
    color: var(--muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    text-decoration: none;
  }
  .nb-nav-icon:hover { color: var(--accent); opacity: 1; }
  .nb-nav-icon svg { width: 15px; height: 15px; }

  .nb-theme {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px 5px 8px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    cursor: pointer;
    background: transparent;
  }
  .nb-theme:hover { color: var(--ink); border-color: var(--accent); }

  /* Light mode: show "switch to dark" option */
  .icon-to-dark { display: inline-flex; align-items: center; gap: 6px; }
  .icon-to-light { display: none; }

  /* Dark mode: show "switch to light" option */
  :global([data-nb-dark="true"]) .icon-to-dark { display: none; }
  :global([data-nb-dark="true"]) .icon-to-light { display: inline-flex; align-items: center; gap: 6px; }

  @media (max-width: 720px) {
    .nb-nav-icon,
    .nb-nav-sep,
    .nb-theme { display: none; }
    .nb-brand-sub { display: none; }
    .nb-header { padding-top: 20px; padding-bottom: 16px; }
  }
</style>
