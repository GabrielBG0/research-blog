---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  num?: string;
  older?: { id: string; data: { title: string } } | null;
  newer?: { id: string; data: { title: string } } | null;
}

const { title, description, pubDate, updatedDate, tags = [], num, older, newer } = Astro.props;

const day = pubDate.toLocaleString("en-US", { day: "numeric" });
const mon = pubDate.toLocaleString("en-US", { month: "short" });
const year = pubDate.toLocaleString("en-US", { year: "numeric" });
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
      integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <Header />
    <main class="nb-page">
      <hr class="nb-rule" style="margin-top: 0;" />

      <div class="nb-post-grid">
        <aside class="nb-margin">
          {num && (
            <>
              <span class="nb-margin-label">§ entry · {num}</span>
              <div class="nb-margin-gap"></div>
            </>
          )}
          <span class="nb-margin-label">Date</span>
          <span class="nb-margin-meta">{day} {mon} {year}</span>
          {updatedDate && (
            <span class="nb-margin-meta" style="font-style: italic;">
              upd. {updatedDate.toLocaleString("en-US", { month: "short", year: "numeric" })}
            </span>
          )}
          {tags.length > 0 && (
            <>
              <div class="nb-margin-gap"></div>
              <span class="nb-margin-label">Tags</span>
              {tags.map(t => <span class="nb-margin-meta">· {t}</span>)}
            </>
          )}
          <div class="nb-margin-gap"></div>
          <span class="nb-margin-label">Cite</span>
          <span class="nb-margin-meta" style="text-transform: none; letter-spacing: .02em; font-style: italic; line-height: 1.55;">
            Gutierrez, G. B. ({year}). "{title}." <em>Research notebook</em>.
          </span>
        </aside>

        <article>
          <a href="/blog" class="nb-back">← Back to index</a>
          <h1 class="nb-h1" style="font-size: clamp(30px, 4vw, 44px); margin-top: 14px;">{title}</h1>
          <div class="nb-post-meta">
            <span>{day} {mon} {year}</span>
            <span class="nb-dot">·</span>
            <span>by Gabriel</span>
            {tags.length > 0 && (
              <>
                <span class="nb-dot">·</span>
                <div class="nb-tag-row" style="display: inline-flex;">
                  {tags.map(t => <span class="nb-tag">{t}</span>)}
                </div>
              </>
            )}
          </div>

          <hr class="nb-rule" />

          <div class="nb-prose">
            <slot />
          </div>

          {(older || newer) && (
            <nav class="nb-postnav" style="margin-top: 36px;" aria-label="Post navigation">
              <div>
                {older && (
                  <>
                    <div class="nb-eyebrow">← Older</div>
                    <a href={`/blog/${older.id}/`} class="nb-link-title">{older.data.title}</a>
                  </>
                )}
              </div>
              <div>
                {newer && (
                  <>
                    <div class="nb-eyebrow" style="text-align: right;">Newer →</div>
                    <a href={`/blog/${newer.id}/`} class="nb-link-title">{newer.data.title}</a>
                  </>
                )}
              </div>
            </nav>
          )}
        </article>
      </div>
    </main>
    <Footer />
  </body>
</html>
